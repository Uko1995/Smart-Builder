# Copy to .env and replace every placeholder. Never commit the filled-in file.

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://spl:spl@127.0.0.1:5432/soccer_prediction_lab

# At least 32 random characters. Used to sign session tokens.
AUTH_SECRET=replace-with-32-plus-random-chars

# Single dashboard user. The password must be at least 12 characters.
DASHBOARD_USERNAME=analyst
DASHBOARD_PASSWORD=replace-with-a-long-password

# development | test | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API directly.
# The Next.js server proxy does not need the browser to call FastAPI.
CORS_ORIGINS=http://localhost:3000

# Include clearly labelled synthetic demo rows in prediction runs.
ALLOW_SYNTHETIC=false

# Leave unset to enable API docs outside production.
# ENABLE_DOCS=false

ODDS_FRESHNESS_MINUTES=180
FIXTURE_REFETCH_MINUTES=360
ODDS_REFETCH_MINUTES=60
PREDICTION_TIME_BUDGET_SECONDS=25
PREDICTION_TIME_BUDGET_CAP_SECONDS=60

MIN_PROBABILITY_A=0.40
MIN_PROBABILITY_B=0.28
MIN_PROBABILITY_C=0.18
MIN_DATA_QUALITY=0.25
MIN_TEAM_MATCHES=5
TARGET_ODDS_MIN=10
TARGET_ODDS_MAX=30
MAX_SLIP_LEGS=5
BEAM_WIDTH=30
RHO_MIN_MATCHES=80

# Optional. Leave blank when the provider is not configured.
API_FOOTBALL_KEY=
ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=

# Comma-separated. Each Odds API sport and market spends free-tier credits.
ODDS_API_SPORTS=soccer_epl
ODDS_API_BOOKMAKERS=onexbet
API_FOOTBALL_LEAGUE_IDS=
FOOTBALL_DATA_COMPETITIONS=PL

LOG_LEVEL=INFO

# Server-side only. Used by the Next.js process, not the browser.
BACKEND_URL=http://127.0.0.1:8000
