# Copy to .env and replace every placeholder. Never commit the filled-in file.

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://spl:spl@127.0.0.1:5432/soccer_prediction_lab

# At least 32 random characters. Used to sign session tokens.
AUTH_SECRET=replace-with-32-plus-random-chars

# Single dashboard user. The password must be at least 12 characters.
DASHBOARD_USERNAME=analyst
DASHBOARD_PASSWORD=replace-with-a-long-password

# development | test | production
ENVIRONMENT=development

# Include clearly labelled synthetic demo rows in prediction runs.
ALLOW_SYNTHETIC=false

ODDS_FRESHNESS_MINUTES=180
FIXTURE_REFETCH_MINUTES=360
ODDS_REFETCH_MINUTES=60
PREDICTION_TIME_BUDGET_SECONDS=25
PREDICTION_TIME_BUDGET_CAP_SECONDS=240

# Unpriced predictions older than this are deleted by the daily job to stay inside Neon's free storage.
PREDICTION_RETENTION_DAYS=21

# Vercel sends this as a Bearer token to /api/cron/daily. Use 32+ random characters.
CRON_SECRET=

MIN_PICK_PROBABILITY=0.50
MIN_DATA_QUALITY=0.25
MIN_TEAM_MATCHES=5
RHO_MIN_MATCHES=80

# Optional. Leave blank when the provider is not configured.
API_FOOTBALL_KEY=
ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=

# Comma-separated. Each Odds API sport and market spends free-tier credits.
ODDS_API_SPORTS=soccer_epl
ODDS_API_BOOKMAKERS=onexbet
ODDS_API_MARKETS=h2h,totals
# Optional per-match markets, about one credit per market per match.
ODDS_API_EVENT_MARKETS=
ODDS_API_MAX_EVENTS=20

# Free CSV history and fixtures. Empty league list means every supported league.
FOOTBALL_DATA_CO_UK_ENABLED=true
FOOTBALL_DATA_CO_UK_LEAGUES=
HISTORY_SEASONS=15
API_FOOTBALL_LEAGUE_IDS=
FOOTBALL_DATA_COMPETITIONS=PL
